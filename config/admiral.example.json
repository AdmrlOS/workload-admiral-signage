{
  "name": "admiral-signage-development",
  "image": "ghcr.io/admrlos/workload-admiral-signage:studio-20261010-live",
  "desiredState": "RUNNING",
  "command": [],
  "env": {
    "SIGNAGE_VIDEO_MODE": "holepunch",
    "SIGNAGE_DECODER": "v4l2slh264dec",
    "SIGNAGE_ALLOW_SOFTWARE": "0",
    "SIGNAGE_PAGE": "player",
    "SIGNAGE_HTTP_HOST": "0.0.0.0",
    "SIGNAGE_HTTP_PORT": "8080",
    "SIGNAGE_DATA_DIR": "/data"
  },
  "options": {
    "interactive": true,
    "isolateDevices": false,
    "readOnlyRoot": false,
    "namespaces": []
  },
  "volumes": {
    "signage-data": {
      "destination": "/data",
      "options": ["bind", "rw"]
    }
  },
  "ports": [{"port": 8080, "protocol": "tcp"}]
}
